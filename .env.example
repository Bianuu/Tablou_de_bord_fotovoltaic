# Copiază în .env.local numai pentru dezvoltare locală; nu comite chei în Git.
# Aplicația funcționează pe Vercel fără aceste variabile; fiecare utilizator poate folosi BYOK din UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# OBLIGATORIU dacă folosești măcar o cheie de server de mai sus.
# Fără acest cod, folosirea cheilor de server este dezactivată ca să prevină cheltuieli neautorizate.
# Pentru un public mare folosește și autentificare, rate limiting / WAF și bugete API.
SERVER_KEYS_ACCESS_CODE=
