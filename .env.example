# Copiază acest fișier în .env.local (local) sau setează variabilele în
# Vercel -> Project -> Settings -> Environment Variables.
# Toate sunt opționale: dacă lipsesc, cheia se introduce direct în interfață (BYOK).
# Atenție: o cheie setată aici poate fi folosită de oricine deschide aplicația publicată.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Opțional: dacă este setat, cheile de mai sus se folosesc doar de cine introduce acest cod în aplicație.
# Cheile introduse direct în pagină (BYOK) funcționează oricum.
SERVER_KEYS_ACCESS_CODE=
